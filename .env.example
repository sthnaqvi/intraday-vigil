# Copy to the daemon's state-dir .env (see `vigil paths` for its location) and fill in
# real values. Never commit the filled-in file — chmod 600 it once it has real secrets.

# Zerodha Kite Connect app credentials — https://developers.kite.trade
# Set the app's redirect URL to http://127.0.0.1:3100/kite-token-exchange (or the port/path
# in src/vigil/config.py's LOGIN_LISTEN_PORT / LOGIN_REDIRECT_PATH, if you've changed them).
KITE_API_KEY=
KITE_API_SECRET=
